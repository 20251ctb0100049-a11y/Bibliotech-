        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% Classes Principais e Herança (Nível C)\n    class Usuario {\n        - id: int\n        - nome: String\n        - email: String\n        + autenticar(): boolean\n        + recuperarSenha(): void\n    }\n\n    class Bibliotecario {\n        - numFuncional: String\n        + gerarRelatorio(): void\n        + gerenciarAcervo(): void\n    }\n\n    class Leitor {\n        - matricula: String\n        - telefone: String\n        + consultarAcervo(): List\n        + verificarHistorico(): void\n    }\n\n    Usuario &lt;|-- Bibliotecario\n    Usuario &lt;|-- Leitor\n\n    %% Classes do Domínio\n    class Emprestimo {\n        - dataEmprestimo: Date\n        - dataDevolucaoPrevista: Date\n        - status: String\n        + cadastrarEmprestimo(): void\n        + registrarDevolucao(): void\n    }\n\n    class Livro {\n        - isbn: String\n        - titulo: String\n        - autor: String\n        - exemplaresDisponiveis: int\n        + verificarDisponibilidade(): boolean\n    }\n\n    %% Classe Nova (Nível B/A)\n    class Reserva {\n        - dataReserva: Date\n        - status: String\n        + cancelarReserva(): void\n    }\n\n    %% Associações e Multiplicidades\n    Bibliotecario \&quot;1\&quot; -- \&quot;0..*\&quot; Emprestimo : registra\n    Leitor \&quot;1\&quot; -- \&quot;0..*\&quot; Emprestimo : realiza\n    Emprestimo \&quot;0..*\&quot; -- \&quot;1\&quot; Livro : contém\n    Livro \&quot;1\&quot; -- \&quot;0..*\&quot; Reserva : refere-se a&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mnDxf7tvNKPpUYKrNby8-1">
